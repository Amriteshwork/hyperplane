# Build context is the repo root (images need backend/ + content/ + datasets/).
**/.git
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/.angular
**/dist
**/coverage
**/test-results
**/playwright-report
.data
.env
.env.*
!.env.example
docs
*.md
!content/**/*.md
!datasets/**/*.md

# Backend tests are not part of the runtime image.
backend/tests

# Fetched at build time instead (see scripts/sample_datasets.py).
datasets/diabetes/data.csv
datasets/california-housing/data.csv
