"""Train a Ridge regression model. Generated by Hyperplane: this is the exact code that ran."""

# @a:imports
import joblib
import numpy as np
import pandas as pd
from sklearn.base import clone
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LinearRegression, Ridge
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
{% if categorical_features %}
from sklearn.preprocessing import OneHotEncoder, StandardScaler
{% else %}
from sklearn.preprocessing import StandardScaler
{% endif %}

# @a:config
DATA_FILE = {{ data_file | py }}
TARGET = {{ target | py }}
NUMERIC_FEATURES = {{ numeric_features | py }}
CATEGORICAL_FEATURES = {{ categorical_features | py }}
TEST_SIZE = {{ test_size | py }}
SEED = {{ seed | py }}

# @a:load
df = pd.read_csv(DATA_FILE).dropna(subset=[TARGET])
X = df[NUMERIC_FEATURES + CATEGORICAL_FEATURES]
y = df[TARGET]

# @a:split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=TEST_SIZE, random_state=SEED
)

# @a:preprocess
numeric = Pipeline([
    ("impute", SimpleImputer(strategy="median")),
    ("scale", StandardScaler()),
])
{% if categorical_features %}
categorical = Pipeline([
    ("impute", SimpleImputer(strategy="most_frequent")),
    ("encode", OneHotEncoder(handle_unknown="ignore")),
])
{% endif %}
preprocess = ColumnTransformer([
    ("numeric", numeric, NUMERIC_FEATURES),
{% if categorical_features %}
    ("categorical", categorical, CATEGORICAL_FEATURES),
{% endif %}
])

# @a:model
model = Ridge(
{% for name, value in params.items() %}
    {{ name }}={{ value | py }},
{% endfor %}
)
pipeline = Pipeline([("preprocess", preprocess), ("model", model)])

# @a:fit
pipeline.fit(X_train, y_train)

# @a:evaluate
predictions = pipeline.predict(X_test)
print(f"R²:   {r2_score(y_test, predictions):.4f}")
print(f"RMSE: {mean_squared_error(y_test, predictions) ** 0.5:.4f}")
print(f"MAE:  {mean_absolute_error(y_test, predictions):.4f}")

# @a:shrinkage
ols = Pipeline([("preprocess", clone(preprocess)), ("model", LinearRegression())])
ols.fit(X_train, y_train)
print(f"Linear Regression test R²: {r2_score(y_test, ols.predict(X_test)):.4f}")
print(f"Coefficient size ‖β‖₂: Ridge {np.linalg.norm(model.coef_):.4f}, "
      f"Linear Regression {np.linalg.norm(ols.named_steps['model'].coef_):.4f}")

# @a:coefficients
feature_names = pipeline.named_steps["preprocess"].get_feature_names_out()
coefficients = pd.Series(model.coef_, index=feature_names).sort_values(key=abs, ascending=False)
print(f"Intercept: {model.intercept_:.4f}")
print(coefficients.to_string())

# @a:save
joblib.dump(pipeline, "model.joblib")
