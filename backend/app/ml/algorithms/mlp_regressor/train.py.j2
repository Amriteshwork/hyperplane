"""Train an MLP regression network. Generated by Hyperplane: this is the exact code that ran."""

# @a:imports
import joblib
import pandas as pd
from sklearn.base import clone
from sklearn.compose import ColumnTransformer, TransformedTargetRegressor
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.neural_network import MLPRegressor
from sklearn.pipeline import Pipeline
{% if categorical_features %}
from sklearn.preprocessing import OneHotEncoder, StandardScaler
{% else %}
from sklearn.preprocessing import StandardScaler
{% endif %}

# @a:config
DATA_FILE = {{ data_file | py }}
TARGET = {{ target | py }}
NUMERIC_FEATURES = {{ numeric_features | py }}
CATEGORICAL_FEATURES = {{ categorical_features | py }}
TEST_SIZE = {{ test_size | py }}
SEED = {{ seed | py }}

# @a:load
df = pd.read_csv(DATA_FILE).dropna(subset=[TARGET])
X = df[NUMERIC_FEATURES + CATEGORICAL_FEATURES]
y = df[TARGET]

# @a:split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=TEST_SIZE, random_state=SEED
)

# @a:preprocess
numeric = Pipeline([
    ("impute", SimpleImputer(strategy="median")),
    ("scale", StandardScaler()),
])
{% if categorical_features %}
categorical = Pipeline([
    ("impute", SimpleImputer(strategy="most_frequent")),
    ("encode", OneHotEncoder(handle_unknown="ignore")),
])
{% endif %}
preprocess = ColumnTransformer([
    ("numeric", numeric, NUMERIC_FEATURES),
{% if categorical_features %}
    ("categorical", categorical, CATEGORICAL_FEATURES),
{% endif %}
])

# @a:model
mlp = MLPRegressor(
    hidden_layer_sizes={{ ([params.hidden_units] * params.hidden_layers) | py }},
{% for name, value in params.items() if name not in ("hidden_layers", "hidden_units") %}
{% if name == "batch_size" and value is none %}
    batch_size="auto",
{% else %}
    {{ name }}={{ value | py }},
{% endif %}
{% endfor %}
)
# @a:scale-target
model = TransformedTargetRegressor(regressor=mlp, transformer=StandardScaler())
pipeline = Pipeline([("preprocess", preprocess), ("model", model)])

# @a:fit
pipeline.fit(X_train, y_train)
mlp = model.regressor_  # the fitted network inside the wrapper
{% if params.solver == "lbfgs" %}
print(f"Stopped after {mlp.n_iter_} L-BFGS iterations; final loss {mlp.loss_:.4f}")
{% else %}
print(f"Stopped after {mlp.n_iter_} epochs ({mlp.t_:,} rows seen); final loss {mlp.loss_:.4f}")
{% endif %}

# @a:evaluate
predictions = pipeline.predict(X_test)
print(f"R²:   {r2_score(y_test, predictions):.4f}")
print(f"RMSE: {mean_squared_error(y_test, predictions) ** 0.5:.4f}")
print(f"MAE:  {mean_absolute_error(y_test, predictions):.4f}")

# @a:loss-curve
{% if params.solver == "lbfgs" %}
print("L-BFGS uses every row in each step, so there are no epochs and no loss curve.")
{% else %}
step = max(1, len(mlp.loss_curve_) // 10)
for epoch in range(0, len(mlp.loss_curve_), step):
    print(f"Epoch {epoch + 1:4d}: training loss {mlp.loss_curve_[epoch]:.4f}")
{% if params.early_stopping %}
best = max(range(len(mlp.validation_scores_)), key=mlp.validation_scores_.__getitem__)
print(f"Best validation R² {mlp.best_validation_score_:.4f} at epoch {best + 1}; its weights were kept")
{% endif %}
{% endif %}

# @a:overfit
train_r2 = r2_score(y_train, pipeline.predict(X_train))
print(f"Training R² {train_r2:.4f} vs test R² {r2_score(y_test, predictions):.4f}")

# @a:baseline
linear = Pipeline([("preprocess", clone(preprocess)), ("model", LinearRegression())])
linear.fit(X_train, y_train)
print(f"Linear Regression test R²: {r2_score(y_test, linear.predict(X_test)):.4f}")

# @a:weights
shapes = [w.shape for w in mlp.coefs_]
n_weights = sum(w.size for w in mlp.coefs_) + sum(b.size for b in mlp.intercepts_)
print(f"Weight matrices per layer: {shapes}; {n_weights:,} parameters for {len(X_train):,} rows")

# @a:save
joblib.dump(pipeline, "model.joblib")
