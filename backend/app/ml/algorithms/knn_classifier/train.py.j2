"""Train a KNN classifier. Generated by Hyperplane: this is the exact code that ran."""

# @a:imports
import joblib
import pandas as pd
from sklearn.base import clone
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    f1_score,
    log_loss,
    pairwise_distances,
    precision_score,
    recall_score,
    roc_auc_score,
)
from sklearn.model_selection import cross_val_score, train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.pipeline import Pipeline
{% if categorical_features %}
from sklearn.preprocessing import OneHotEncoder, StandardScaler
{% else %}
from sklearn.preprocessing import StandardScaler
{% endif %}

# @a:config
DATA_FILE = {{ data_file | py }}
TARGET = {{ target | py }}
NUMERIC_FEATURES = {{ numeric_features | py }}
CATEGORICAL_FEATURES = {{ categorical_features | py }}
TEST_SIZE = {{ test_size | py }}
SEED = {{ seed | py }}

# @a:load
df = pd.read_csv(DATA_FILE).dropna(subset=[TARGET])
X = df[NUMERIC_FEATURES + CATEGORICAL_FEATURES]
y = df[TARGET]

# @a:split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=TEST_SIZE, random_state=SEED
)

# @a:preprocess
numeric = Pipeline([
    ("impute", SimpleImputer(strategy="median")),
    ("scale", StandardScaler()),
])
{% if categorical_features %}
categorical = Pipeline([
    ("impute", SimpleImputer(strategy="most_frequent")),
    ("encode", OneHotEncoder(handle_unknown="ignore")),
])
{% endif %}
preprocess = ColumnTransformer([
    ("numeric", numeric, NUMERIC_FEATURES),
{% if categorical_features %}
    ("categorical", categorical, CATEGORICAL_FEATURES),
{% endif %}
])

# @a:model
model = KNeighborsClassifier(
{% for name, value in params.items() %}
    {{ name }}={{ value | py }},
{% endfor %}
)
pipeline = Pipeline([("preprocess", preprocess), ("model", model)])

# @a:fit
pipeline.fit(X_train, y_train)
print(f"Stored {model.n_samples_fit_:,} rows of {model.n_features_in_} features: nothing else was learned")

# @a:predict
predictions = pipeline.predict(X_test)
probabilities = pipeline.predict_proba(X_test)  # one column per class, in model.classes_ order
print(f"Classes: {list(model.classes_)}")

# @a:evaluate
{% if task_type == "binary" %}
positive = model.classes_[1]  # scikit-learn's positive class: the last, in sorted order
scores = {"pos_label": positive, "zero_division": 0}
print(f"Accuracy:  {accuracy_score(y_test, predictions):.4f}")
print(f"Precision: {precision_score(y_test, predictions, **scores):.4f}  (of rows called {positive})")
print(f"Recall:    {recall_score(y_test, predictions, **scores):.4f}  (of actual {positive} rows)")
print(f"F1:        {f1_score(y_test, predictions, **scores):.4f}")
print(f"Log-loss:  {log_loss(y_test, probabilities, labels=model.classes_):.4f}")
if y_test.nunique() == 2:  # ROC needs both classes among the test rows
    print(f"ROC-AUC:   {roc_auc_score(y_test == positive, probabilities[:, 1]):.4f}")
{% else %}
scores = {"average": "macro", "labels": model.classes_, "zero_division": 0}
print(f"Accuracy:          {accuracy_score(y_test, predictions):.4f}")
print(f"Precision (macro): {precision_score(y_test, predictions, **scores):.4f}")
print(f"Recall (macro):    {recall_score(y_test, predictions, **scores):.4f}")
print(f"F1 (macro):        {f1_score(y_test, predictions, **scores):.4f}")
print(f"Log-loss:          {log_loss(y_test, probabilities, labels=model.classes_):.4f}")
if y_test.nunique() == len(model.classes_):  # ROC needs every class among the test rows
    auc = roc_auc_score(y_test, probabilities, multi_class="ovr", labels=model.classes_)
    print(f"ROC-AUC (macro):   {auc:.4f}")
{% endif %}

# @a:confusion
matrix = confusion_matrix(y_test, predictions, labels=model.classes_)
print(pd.DataFrame(matrix, index=model.classes_, columns=model.classes_)
      .rename_axis(index="actual", columns="predicted"))

# @a:neighbours
distances, rows = model.kneighbors(preprocess.transform(X_test.head(1)))
print(f"First test row: predicted {predictions[0]}, actual {y_test.iloc[0]}. Its neighbours:")
print(pd.DataFrame({"distance": distances[0], TARGET: y_train.iloc[rows[0]].to_numpy()}).to_string())

# @a:nearness
queries = preprocess.transform(X_test.head(200))
stored = preprocess.transform(X_train.head(2000))
nearest = model.kneighbors(queries)[0][:, -1].mean()
typical = pairwise_distances(queries, stored, metric=model.metric).mean()
print(f"The k-th neighbour is {nearest:.4f} away on average; a typical stored row, {typical:.4f}")

# @a:overfit
train_accuracy = accuracy_score(y_train, pipeline.predict(X_train))
print(f"Training accuracy {train_accuracy:.4f} vs test accuracy {accuracy_score(y_test, predictions):.4f}")

# @a:choose-k
if len(X_train) <= 20_000:  # every k means five fits and a prediction for every row
    largest = len(X_train) * 4 // 5  # each fold trains on 4/5 of the rows
    for k in sorted(k for k in {1, 3, 5, 10, 20, 50, model.n_neighbors} if k <= largest):
        candidate = clone(pipeline).set_params(model__n_neighbors=k)
        score = cross_val_score(candidate, X_train, y_train, cv=5).mean()
        print(f"k = {k:4d}: cross-validated accuracy {score:.4f}")

# @a:baseline
linear = Pipeline([("preprocess", clone(preprocess)), ("model", LogisticRegression(max_iter=1000))])
linear.fit(X_train, y_train)
print(f"Logistic Regression test accuracy: {accuracy_score(y_test, linear.predict(X_test)):.4f}")

# @a:save
joblib.dump(pipeline, "model.joblib")
