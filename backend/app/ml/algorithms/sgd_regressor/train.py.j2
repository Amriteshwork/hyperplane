"""Train an SGD regression model. Generated by Hyperplane: this is the exact code that ran."""

# @a:imports
import warnings

import joblib
import pandas as pd
from sklearn.base import clone
from sklearn.compose import ColumnTransformer, TransformedTargetRegressor
from sklearn.exceptions import ConvergenceWarning
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LinearRegression, SGDRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
{% if categorical_features %}
from sklearn.preprocessing import OneHotEncoder, StandardScaler
{% else %}
from sklearn.preprocessing import StandardScaler
{% endif %}

# @a:config
DATA_FILE = {{ data_file | py }}
TARGET = {{ target | py }}
NUMERIC_FEATURES = {{ numeric_features | py }}
CATEGORICAL_FEATURES = {{ categorical_features | py }}
TEST_SIZE = {{ test_size | py }}
SEED = {{ seed | py }}

# @a:load
df = pd.read_csv(DATA_FILE).dropna(subset=[TARGET])
X = df[NUMERIC_FEATURES + CATEGORICAL_FEATURES]
y = df[TARGET]

# @a:split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=TEST_SIZE, random_state=SEED
)

# @a:preprocess
numeric = Pipeline([
    ("impute", SimpleImputer(strategy="median")),
    ("scale", StandardScaler()),
])
{% if categorical_features %}
categorical = Pipeline([
    ("impute", SimpleImputer(strategy="most_frequent")),
    ("encode", OneHotEncoder(handle_unknown="ignore")),
])
{% endif %}
preprocess = ColumnTransformer([
    ("numeric", numeric, NUMERIC_FEATURES),
{% if categorical_features %}
    ("categorical", categorical, CATEGORICAL_FEATURES),
{% endif %}
])

# @a:model
sgd = SGDRegressor(
{% for name, value in params.items() %}
    {{ name }}={{ value | py }},
{% endfor %}
)
# @a:scale-target
model = TransformedTargetRegressor(regressor=sgd, transformer=StandardScaler())
pipeline = Pipeline([("preprocess", preprocess), ("model", model)])

# @a:fit
pipeline.fit(X_train, y_train)
sgd = model.regressor_  # the fitted SGDRegressor inside the wrapper
print(f"Stopped after {sgd.n_iter_} epochs: {sgd.n_iter_ * len(X_train):,} one-row updates")

# @a:evaluate
predictions = pipeline.predict(X_test)
print(f"R²:   {r2_score(y_test, predictions):.4f}")
print(f"RMSE: {mean_squared_error(y_test, predictions) ** 0.5:.4f}")
print(f"MAE:  {mean_absolute_error(y_test, predictions):.4f}")

# @a:epochs
for epochs in (1, 2, 5, 10, 20):
    capped = clone(pipeline).set_params(
        model__regressor__max_iter=epochs,
        model__regressor__tol=None,
        model__regressor__early_stopping=False,
    )
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", ConvergenceWarning)  # stopping early is the point
        capped.fit(X_train, y_train)
    print(f"After {epochs:2d} epoch(s): test R² {r2_score(y_test, capped.predict(X_test)):.4f}")

# @a:exact
ols = Pipeline([("preprocess", clone(preprocess)), ("model", LinearRegression())])
ols.fit(X_train, y_train)
print(f"Linear Regression (exact least squares) test R²: {r2_score(y_test, ols.predict(X_test)):.4f}")

# @a:coefficients
feature_names = pipeline.named_steps["preprocess"].get_feature_names_out()
y_mean, y_scale = model.transformer_.mean_[0], model.transformer_.scale_[0]
coefficients = pd.Series(sgd.coef_ * y_scale, index=feature_names)  # back in the target's units
coefficients = coefficients.sort_values(key=abs, ascending=False)
print(f"Intercept: {sgd.intercept_[0] * y_scale + y_mean:.4f}")
print(coefficients.to_string())

# @a:save
joblib.dump(pipeline, "model.joblib")
