# Copy to /opt/hyperplane/.env on the server (chmod 600) and fill in every empty value.
# Generate hex secrets with: openssl rand -hex 32

COMPOSE_PROJECT_NAME=hyperplane

# The public site; the browser calls /api on the same origin, so this is only a fallback.
CORS_ORIGINS=https://traintestval.com

POSTGRES_USER=hyperplane
POSTGRES_DB=hyperplane
# Hex only: it is embedded in DATABASE_URL. Takes effect on the first start only.
POSTGRES_PASSWORD=

S3_REGION=garage
S3_BUCKET=hyperplane
# "GK" + 24 hex chars: echo "GK$(openssl rand -hex 12)"
S3_ACCESS_KEY_ID=
# 64 hex chars.
S3_SECRET_ACCESS_KEY=

# 64 hex chars.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# Cloudflare → Zero Trust → Networks → Tunnels → your tunnel → the token in its install command.
CLOUDFLARE_TUNNEL_TOKEN=
